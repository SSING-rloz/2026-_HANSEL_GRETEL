Panels:
  - Class: rviz/Displays
    Help Height: 80
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Filtered Radar Points1
        - /3D Rolling Local Cloud1
      Splitter Ratio: 0.55
    Tree Height: 620
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 0.5
      Class: rviz/Grid
      Color: 120; 120; 120
      Enabled: true
      Line Style:
        Line Width: 0.0299999993
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 16
      Reference Frame: radar_link
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Tree: {}
      Update Interval: 0
      Value: true
    - Class: rviz/Axes
      Enabled: true
      Name: Radar Axes
      Length: 0.25
      Radius: 0.018
      Reference Frame: radar_link
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 60; 60
      Min Color: 60; 100; 255
      Name: Filtered Radar Points
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 6
      Size (m): 0.025
      Style: Points
      Topic: /radar/points_3d_filtered
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.75
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 80; 80
      Min Color: 70; 100; 255
      Name: 3D Rolling Local Cloud
      Position Transformer: XYZ
      Queue Size: 20
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.035
      Style: Points
      Topic: /radar/rolling_map_3d
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /radar/rviz_guides_3d
      Name: 3D FOV Wireframe
      Namespaces:
        radar_3d_fov: true
      Queue Size: 10
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 32; 38
    Default Light: true
    Fixed Frame: radar_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 5.5
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.0599999987
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.2
        Y: 0
        Z: 0.45
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.62
      Target Frame: radar_link
      Yaw: -1.57
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1250
  X: 80
  Y: 50
