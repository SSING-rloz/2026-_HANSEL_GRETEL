# HANSEL/GRETEL Node3 Pi - service environment
#
# Node3 static IP: 192.168.4.13 (set by net/setup_static_ip.sh)
# Video relay chain: Head -> Node1 -> Node2 -> Node3 -> Android(192.168.4.20)
#
# Node3 is the LAST relay hop: it forwards to the Android phone.

# Where Node3 forwards the incoming video to (final hop = Android phone).
RELAY_DST_IP=192.168.4.20

# Raw H.264 Annex-B over UDP video port (keep 5001).
RELAY_LISTEN_PORT=5001
RELAY_DST_PORT=5001
