# HANSEL/GRETEL Node2 Pi - service environment
#
# Node2 static IP: 192.168.4.12 (set by net/setup_static_ip.sh)
# Video relay chain: Head -> Node1 -> Node2 -> Node3(192.168.4.13) -> Android

# Where Node2 forwards the incoming video to (next hop = Node3).
RELAY_DST_IP=192.168.4.13

# Raw H.264 Annex-B over UDP video port (keep 5001).
RELAY_LISTEN_PORT=5001
RELAY_DST_PORT=5001
