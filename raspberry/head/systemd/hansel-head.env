# HANSEL/GRETEL Head Pi - service environment
#
# Single place to manage Head runtime values used by the systemd services.
# Edit here, then: sudo systemctl restart hansel-head-camera.service (etc.)

# Head AP address (assigned by start_ap.sh; informational here).
HEAD_AP_IP=192.168.4.1

# First video hop: where the Head camera sender pushes the H.264/UDP stream.
# Default chain is Head -> Node1(192.168.4.11) -> Node2 -> Node3 -> Android.
VIDEO_FIRST_HOP_IP=192.168.4.11

# Raw H.264 Annex-B over UDP video port (do NOT change without reason).
VIDEO_PORT=5001

# Monitor / auto-detach tuning (forwarded to run_monitor.sh via run_guard_detach.sh).
MONITOR_IFACE=wlan0
MONITOR_THRESHOLD=-70
MONITOR_DEGRADED_COUNT=10
MONITOR_RECOVER_COUNT=6
