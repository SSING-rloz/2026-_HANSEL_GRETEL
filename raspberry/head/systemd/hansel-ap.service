[Unit]
Description=HANSEL Head Pi AP (hostapd/dnsmasq via start_ap.sh)
Documentation=file:__HEAD_DIR__/ap/start_ap.sh
Wants=network.target
After=network.target
# DANGER: starting this switches wlan0 from client to AP mode and can drop
# any SSH session that runs over wlan0. The install script enables but does
# NOT start this unit; first activation is a deliberate operator action.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash __HEAD_DIR__/ap/start_ap.sh --yes
# stop_ap.sh restores client mode; run manually for recovery.
ExecStop=/bin/bash __HEAD_DIR__/ap/stop_ap.sh --yes

[Install]
WantedBy=multi-user.target
