# HANSEL/GRETEL Node1 Pi - service environment
#
# Node1 static IP: 192.168.4.11 (set by net/setup_static_ip.sh)
# Video relay chain: Head -> Node1 -> Node2(192.168.4.12) -> Node3 -> Android

# Where Node1 forwards the incoming video to (next hop = Node2).
RELAY_DST_IP=192.168.4.12

# Raw H.264 Annex-B over UDP video port (keep 5001).
RELAY_LISTEN_PORT=5001
RELAY_DST_PORT=5001
